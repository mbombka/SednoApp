{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Model": {
    "Provider": "openai",
    "OpenAI": {
      "Model": "gpt-6-luna",
      "MaxOutputTokens": 4096,
      "TimeoutSeconds": 8,
      "ServiceTier": "default",
      "ReasoningEffort": "none"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Billing": {
    "Enabled": false
  }
}
