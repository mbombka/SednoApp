{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Model": {
    "Provider": "openai",
    "OpenAI": {
      "Model": "gpt-6-luna",
      "MaxOutputTokens": 4096,
      "TimeoutSeconds": 8,
      "ServiceTier": "default",
      "ReasoningEffort": "none"
    }
  },
  "PlayIntegrity": {
    "PackageName": "xyz.sedno.app"
  },
  "Billing": {
    "Enabled": false,
    "PackageName": "xyz.sedno.app"
  },
  "Firestore": {
    "DatabaseId": "(default)",
    "UseEmulator": false
  }
}
