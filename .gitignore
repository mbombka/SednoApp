migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/mobile/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Backend local configuration and build output
**/bin/
# Some .NET build tasks create a literal backslash in the directory name on Linux.
**/bin\\Debug/
**/obj/
backend/.env
backend/**/appsettings.Local.json

# Local Firebase deployment manifests and Android Firebase configuration
/backend/deploy/generated/
**/google-services.json
.firebase/
firebase-debug.log*

# Local deployment tools and Firebase build configuration
/backend/.local-tools/
/mobile/config/*.local.json
firepit-log.txt

# Android upload signing credentials (keep a separate secure backup)
/mobile/android/key.properties
/mobile/android/keystore/
*.jks
*.keystore
**/.kotlin/
