RewriteEngine On

# Old Polish URLs remain valid and resolve directly to the preferred page.
RewriteRule ^pl(?:/index\.html|/)?$ https://sedno.xyz/ [R=301,L]
RewriteRule ^pl/account(?:/index\.html|/)?$ https://sedno.xyz/konto/ [R=301,L]
RewriteRule ^prywatnosc(?:/index\.html|/)?$ https://sedno.xyz/pl/privacy/ [R=301,L]
RewriteRule ^usun-konto(?:/index\.html|/)?$ https://sedno.xyz/pl/delete-account/ [R=301,L]

# Match an explicit request for index.html and leave DirectoryIndex alone.
RewriteCond %{THE_REQUEST} "\s/+[^?\s]*index\.html[?\s]"
RewriteRule ^(.*/)?index\.html$ https://sedno.xyz/$1 [R=301,L]

# Give directory URLs a trailing slash on the preferred origin in the same step.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://sedno.xyz/$1/ [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.sedno\.xyz$ [NC]
RewriteRule ^ https://sedno.xyz%{REQUEST_URI} [R=301,L,NE]

# OVH may terminate TLS before Apache.
RewriteCond %{HTTP_HOST} ^sedno\.xyz$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://sedno.xyz%{REQUEST_URI} [R=301,L,NE]
